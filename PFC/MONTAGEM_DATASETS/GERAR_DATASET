import numpy as np
import pandas as pd

def to_binary_label(v) -> int:
    if pd.isna(v):
        return 0
    if isinstance(v, (int, np.integer)):
        return int(v != 0)
    if isinstance(v, (float, np.floating)):
        return int(v != 0.0)

    s = str(v).strip().lower()
    if s in ("1", "true", "t", "sim", "piscada", "blink", "yes", "y"):
        return 1
    if s in ("0", "false", "f", "nao", "não", "sem", "n", "noblink", "no"):
        return 0

    try:
        return int(float(s) != 0.0)
    except Exception:
        return 0



paths = [
    "data/dados_crus/d_c_500_1m_janela/d_c_500_1m_classificado.csv",
    "data/dados_crus/d_m_o_500_1m_janela/d_m_o_500_1m_classificado.csv",
    "data/dados_crus/d_p_d_500_1m_1_janela/d_p_d_500_1m_1_classificado.csv",
    "data/dados_crus/d_p_d_500_1m_2_janela/d_p_d_500_1m_2_classificado.csv",
    "data/dados_crus/d_p_d_500_1m_3_janela/d_p_d_500_1m_3_classificado.csv",
    "data/dados_crus/d_p_d_500_1m_4_janela/d_p_d_500_1m_4_classificado.csv",
    "data/dados_crus/d_p_d_500_1m_5_janela/d_p_d_500_1m_5_classificado.csv",
]

SEQ_LEN = 250  # tamanho final por janela (amostras)

dfs = []
offset = 0

for p in paths:
    d = pd.read_csv(p)

    required_cols = {"t_s", "sinal_filtrado", "janela", "classificacao"}
    missing = required_cols - set(d.columns)
    if missing:
        raise ValueError(f"CSV {p} sem colunas obrigatórias: {missing}")

    d["janela"] = d["janela"].astype(int)
    d["janela"] = d["janela"] + offset

    # CORRETO: +1 para não repetir o último ID
    offset = int(d["janela"].max())+1

    dfs.append(d)

df = pd.concat(dfs, ignore_index=True)
df = df.sort_values(["janela", "t_s"], kind="mergesort").reset_index(drop=True)
df["class_bin"] = df["classificacao"].apply(to_binary_label)

df.to_csv("meu_arquivo4.csv", index=False, encoding="utf-8", sep=",")