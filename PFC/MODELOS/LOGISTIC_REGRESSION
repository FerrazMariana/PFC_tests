import numpy as np
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
import joblib


# =========================
# 1) Feature extraction
# =========================
def extract_features(x: np.ndarray) -> dict:
    """
    Extrai features simples de uma janela de EOG.
    x: array 1D com amostras do sinal EOG na janela.
    """
    x = np.asarray(x, dtype=np.float64)
    if x.size < 3:
        return {
            "n": int(x.size),
            "mean": 0.0, "std": 0.0, "min": 0.0, "max": 0.0, "ptp": 0.0,
            "rms": 0.0, "energy": 0.0,
            "abs_mean": 0.0, "abs_max": 0.0,
            "skew": 0.0, "kurt": 0.0,
            "dx_abs_mean": 0.0, "dx_abs_max": 0.0,
            "zcr_median": 0.0
        }

    mean = float(np.mean(x))
    std = float(np.std(x, ddof=1)) if x.size > 1 else 0.0
    xmin = float(np.min(x))
    xmax = float(np.max(x))
    ptp = float(xmax - xmin)

    rms = float(np.sqrt(np.mean(x * x)))
    energy = float(np.sum(x * x))

    abs_mean = float(np.mean(np.abs(x)))
    abs_max = float(np.max(np.abs(x)))

    s = pd.Series(x)
    skew = float(s.skew()) if x.size >= 3 else 0.0
    kurt = float(s.kurt()) if x.size >= 4 else 0.0

    dx = np.diff(x)
    dx_abs_mean = float(np.mean(np.abs(dx)))
    dx_abs_max = float(np.max(np.abs(dx)))

    med = np.median(x)
    signs = np.sign(x - med)
    signs[signs == 0] = 1
    zc = np.sum(signs[1:] != signs[:-1])
    zcr_median = float(zc) / float(x.size - 1)

    return {
        "n": int(x.size),
        "mean": mean, "std": std, "min": xmin, "max": xmax, "ptp": ptp,
        "rms": rms, "energy": energy,
        "abs_mean": abs_mean, "abs_max": abs_max,
        "skew": skew, "kurt": kurt,
        "dx_abs_mean": dx_abs_mean, "dx_abs_max": dx_abs_max,
        "zcr_median": zcr_median
    }



# =========================
# 2) Load CSV
# =========================

dataset = "dataset_pedro_f.csv"  
df = pd.read_csv(dataset)

rows = []
for win_id, g in df.groupby("janela", sort=False):
    x = g["sinal_filtrado"].to_numpy()
    feats = extract_features(x)

    # (opção atual) label por MAIORIA
    y_win = int(g["class_bin"].mode().iloc[0]) if len(g) else 0

    feats["janela"] = win_id
    feats["y"] = y_win
    rows.append(feats)

feat_df = pd.DataFrame(rows)

y = feat_df["y"].astype(int)
X = feat_df.drop(columns=["y", "janela"])

print("Amostras (janelas):", len(feat_df))
print("Distribuição classes:\n", y.value_counts(normalize=True).rename("proporção"))


# =========================
# 3) Train/test split + Logistic Regression (leve)
# =========================
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.25,
    random_state=42,
    stratify=y if y.nunique() > 1 else None
)

# Pipeline: padroniza e treina LR
model = Pipeline(steps=[
    ("scaler", StandardScaler()),
    ("clf", LogisticRegression(
        max_iter=5000,
        class_weight="balanced",   # ajuda se piscada for rara
        solver="lbfgs"             # padrão, bom e rápido
    ))
])

model.fit(X_train, y_train)


# =========================
# 4) Evaluate
# =========================
y_prob = model.predict_proba(X_test)[:, 1]
y_pred = (y_prob >= 0.8).astype(int)

labels = [0, 1]
label_names = ["nao_piscada", "piscada"]

cm = confusion_matrix(y_test, y_pred, labels=labels)
cm_df = pd.DataFrame(cm, index=label_names, columns=label_names)

print("\nMatriz de confusão (linhas=real, colunas=predito):\n")
print(cm_df)

print("\nClassification report:\n", classification_report(y_test, y_pred, digits=4))

# AUC (se tiver as duas classes no teste)
if y_test.nunique() == 2:
    y_proba = model.predict_proba(X_test)[:, 1]
    auc = roc_auc_score(y_test, y_proba)
    print(f"AUC: {auc:.4f}")


